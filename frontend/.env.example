# Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# Neon PostgreSQL Database Connection (same as backend)
# Get from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/neondb

# Better Auth Secret (MUST match backend EXACTLY!)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-secret-here

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App URLs (for production, set to your deployed URL)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# Notification System - Push Notifications (VAPID)
# =============================================================================
# VAPID Public Key - MUST match backend VAPID_PUBLIC_KEY
# Used by the browser to subscribe to push notifications
# Generate with backend: python -c "from pywebpush import WebPusher; print(WebPusher.generate_vapid_keys())"

NEXT_PUBLIC_VAPID_PUBLIC_KEY=sfF-0K-Ckco2LQB2ij4x9B5uoge_a8N3cLVNAzXO_0mBWj2KYtzXPmscxIdAl0yWJ8YB11K1iTyITZkit4EjxQ
