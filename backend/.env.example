# Backend Environment Variables
# Copy this file to .env and fill in your values

# Neon PostgreSQL Database Connection
# Get from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=postgresql://username:password@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Better Auth JWT Secret (MUST match frontend)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-32-character-secret-here

# CORS - Allowed frontend origins (comma-separated for multiple)
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# Notification System - Push Notifications (VAPID)
# =============================================================================
# Generate VAPID keys with: python -c "from pywebpush import WebPusher; print(WebPusher.generate_vapid_keys())"
# Or use online: https://vapidkeys.com/
# VAPID_PUBLIC_KEY also needs to be added to frontend as NEXT_PUBLIC_VAPID_PUBLIC_KEY

VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:admin@chronostodo.com

# =============================================================================
# Notification System - Email (Resend)
# =============================================================================
# Get API key from: https://resend.com/api-keys
# Sign up for free at: https://resend.com/
# Free tier: 3,000 emails/month

RESEND_API_KEY=re-your-resend-api-key-here
RESEND_WEBHOOK_SECRET=your-webhook-secret-for-verification

# =============================================================================
# Phase III - AI Chatbot
# =============================================================================
# Note: These are already configured in .env — no action needed for this project

# OpenAI API (for Agents SDK, Whisper transcription, embeddings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Qdrant Cloud Vector Database (for semantic task search)
# Get URL + API key from: https://cloud.qdrant.io → Your Cluster
QDRANT_URL=https://xxxxxxxx.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=eyJhbGci...

# =============================================================================
# Phase III - Configuration
# =============================================================================

# Structured Logging Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# AI Model Configuration
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1

# Chat Rate Limiting (requests per minute per user)
CHAT_RATE_LIMIT_PER_MINUTE=30

# Agent Configuration
MAX_CONVERSATION_HISTORY_MESSAGES=50
CONVERSATION_TITLE_GENERATION_THRESHOLD=3

# Cost Controls (token quotas per user)
MAX_TOKENS_PER_USER_PER_DAY=100000
MAX_TOKENS_PER_USER_PER_MONTH=2000000
MAX_WHISPER_TRANSCRIPTIONS_PER_DAY=100
